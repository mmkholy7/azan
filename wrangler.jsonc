{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "azan",
  "workers_dev": true,
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "azan",
      "database_id": "df291c5d-1cad-4a05-8959-f6e2b5001949",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://azan.melkhouly.workers.dev"
  },
  "observability": { "enabled": false }
}
