{
  "name": "janat-azan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.14" },
  "scripts": {
    "dev": "npm run build && wrangler dev --port 8787 --var PUBLIC_ORIGIN:http://localhost:8787",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "db:local": "wrangler d1 migrations apply azan --local",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "adhan": "^4.4.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "miniflare": "5.20261101.0-beta",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.1"
  }
}
